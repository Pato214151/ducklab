# ── Variables de entorno de Ducklab ──
# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NO se sube a git (contiene secretos).

# Clave para firmar las sesiones (JWT). OBLIGATORIA en producción.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# URL pública del portal (para enlaces, snippets de telemetría, etc.)
NEXT_PUBLIC_URL=http://localhost:3000

# Secreto del webhook de GitHub (firma x-hub-signature-256).
# Debe ser el mismo que configures en GitHub → Settings → Webhooks.
GITHUB_WEBHOOK_SECRET=

# Envío de correos (recuperación de contraseña) vía Resend (https://resend.com).
# Sin esto, el reset de contraseña solo registra el link en consola (modo dev).
RESEND_API_KEY=
EMAIL_FROM=Ducklab <onboarding@resend.dev>
# Correo que recibe las alertas de error crítico (tu correo personal).
# Útil mientras no verifiques un dominio en Resend (solo entrega a tu propio correo).
ALERT_EMAIL=

# Secreto para proteger el cron de health-check (/api/cron/health-check).
# Úsalo en el header Authorization: Bearer <CRON_SECRET> o ?key=<CRON_SECRET>.
CRON_SECRET=

# Conexión a PostgreSQL (cuando migres de db.json). Opcional por ahora.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos

# (Solo dev, seed db.json) Claves de los usuarios de ejemplo. Si no las pones,
# se generan aleatorias (nadie entra con un default conocido). Prod usa Postgres.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
