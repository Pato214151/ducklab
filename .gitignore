# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# permitir el ejemplo documentado
!.env.example

# Launcher build artifacts (binarios pesados — hospedar aparte)
credenciales-iniciales.txt
pocitos-seed-login.txt
telemetry-keys.txt
clave-mes-pocitos.txt
launcher/dist/
launcher/build/
launcher/build_tmp/
launcher/*.spec
launcher/installed_apps/
launcher/session.json
public/downloads/*.exe

# Artefactos del launcher movidos aqui (exe pesado, db runtime, credenciales) — nunca commitear
launcher-artifacts/

# Datos runtime (db.json tiene hashes — NUNCA commitear) y archivos servidos
/data/

# Python bytecode
__pycache__/
*.pyc


.claude/
CLAUDE.md
